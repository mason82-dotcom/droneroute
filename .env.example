# DroneRoute Configuration
PORT=3001
JWT_SECRET=change-this-to-a-random-secret
DB_PATH=./data/droneroute.db

# Self-hosted mode (default: true). Set to false for cloud deployments.
SELF_HOSTED=true

# Allowed cross-origin origins (comma-separated). Only needed when the frontend
# is served from a different origin than the API. Leave unset for the standard
# setup (the SPA is served same-origin), which disables cross-origin requests.
# CORS_ORIGIN=https://app.example.com,https://www.example.com

# Admin email — only used when SELF_HOSTED=false. The user with this email
# gets admin privileges and access to the back office panel.
# ADMIN_EMAIL=admin@example.com

# Map data sources (MapLibre GL). No API key is needed: by default the map uses
# OpenFreeMap (street style, labels, 3D buildings), Esri World Imagery
# (satellite), Mapterhorn (terrain), and Photon (search). Every source can be
# replaced; invalid values fall back to the default.
# MAP_STREET_STYLE=https://tiles.openfreemap.org/styles/dark
# MAP_LABELS_STYLE=https://tiles.openfreemap.org/styles/liberty
# MAP_BUILDINGS_TILES=https://tiles.openfreemap.org/planet
# MAP_IMAGERY_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# MAP_IMAGERY_ATTRIBUTION=Imagery © Esri
# MAP_TERRAIN_TILES=https://tiles.mapterhorn.com/{z}/{x}/{y}.webp
# MAP_TERRAIN_ENCODING=terrarium   (terrarium | mapbox)
# MAP_TERRAIN_TILE_SIZE=512
# MAP_GEOCODER_URL=https://photon.komoot.io/api/   ("off" hides the search box)
#
# Optional regional orthophotos drawn over the imagery (XYZ or WMS with
# {bbox-epsg-3857}), e.g. 20 cm aerial images of Baden-Württemberg (dl-de/by-2-0):
# MAP_ORTHOPHOTO_TILES=https://owsproxy.lgl-bw.de/owsproxy/ows/WMS_LGL-BW_ATKIS_DOP_20_C?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&LAYERS=IMAGES_DOP_20_RGB&STYLES=&CRS=EPSG:3857&BBOX={bbox-epsg-3857}&WIDTH=256&HEIGHT=256&FORMAT=image/png&TRANSPARENT=TRUE
# MAP_ORTHOPHOTO_ATTRIBUTION=Aerial imagery © LGL-BW, dl-de/by-2-0
# MAP_ORTHOPHOTO_BOUNDS=7.5,47.5,10.5,49.8   (west,south,east,north)
# MAP_ORTHOPHOTO_MAXZOOM=20
#
# Optional extra base map in the style switcher, e.g. basemap.de for Germany:
# MAP_EXTRA_STYLE_NAME=basemap.de
# MAP_EXTRA_STYLE_URL=https://sgx.geodatenzentrum.de/gdz_basemapde_vektor/styles/bm_web_col.json

# Default map location shown when the app loads. Handy for self-hosted
# instances so the map opens on your local area instead of the default.
# Format: "lat,lng" or "lat,lng,zoom" (zoom is optional, defaults to 13).
# Ranges: lat -90..90, lng -180..180, zoom 0..22. Invalid values are ignored.
# DEFAULT_MAP_VIEW=41.3874,2.1686,13
